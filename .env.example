BEYOND_WORDS_CORS_ORIGINS=http://localhost:5173
BEYOND_WORDS_DEEPSEEK_ENABLED=true
BEYOND_WORDS_DEEPSEEK_BASE_URL=https://api.deepseek.com
BEYOND_WORDS_DEEPSEEK_MODEL=deepseek-flash
