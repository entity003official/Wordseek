VITE_API_BASE_URL=/api/v1
BEYOND_WORDS_ENV=development
BEYOND_WORDS_DATABASE_URL=sqlite:///./backend/data/beyond_words_v1.db
BEYOND_WORDS_REDIS_URL=
BEYOND_WORDS_CELERY_EAGER=true
BEYOND_WORDS_SESSION_COOKIE_SECURE=false
BEYOND_WORDS_SESSION_SECRET=change-this-to-a-long-random-secret
