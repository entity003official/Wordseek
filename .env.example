BEYOND_WORDS_FFMPEG_PATH=
BEYOND_WORDS_QWEN_WORKSPACE_ID_FILE=./api-key/dashscope_workspace_id.txt
BEYOND_WORDS_QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1
BEYOND_WORDS_QWEN_FILE_MODEL=qwen-audio-3.1-asr-flash-filetrans
BEYOND_WORDS_QWEN_SHORT_MODEL=qwen-audio-3.1-asr-flash
BEYOND_WORDS_QWEN_TTS_MODEL=qwen3-tts-flash
BEYOND_WORDS_QWEN_TTS_VOICE=Cherry
BEYOND_WORDS_QWEN_TTS_GENERATIONS_PER_DAY=30
BEYOND_WORDS_QWEN_AUDIO_URL_MODE=temporary
BEYOND_WORDS_QWEN_MAX_RETRIES=3
BEYOND_WORDS_QWEN_RETRY_BASE_SECONDS=1
BEYOND_WORDS_STORAGE_BACKEND=local
BEYOND_WORDS_MINIO_ENDPOINT=localhost:9000
BEYOND_WORDS_MINIO_ACCESS_KEY=beyondwords
BEYOND_WORDS_MINIO_SECRET_KEY=change-this-minio-secret
BEYOND_WORDS_MINIO_BUCKET=beyond-words
BEYOND_WORDS_OIDC_ENABLED=false
BEYOND_WORDS_OIDC_ISSUER=
BEYOND_WORDS_OIDC_CLIENT_ID=
BEYOND_WORDS_OIDC_CLIENT_SECRET=
BEYOND_WORDS_DATA_DIR=./backend/data
BEYOND_WORDS_MAX_AUDIO_BYTES=262144000
BEYOND_WORDS_GRAFANA_URL=http://127.0.0.1:13000
GRAFANA_HOST_PORT=13000
